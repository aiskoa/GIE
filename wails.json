{
  "$schema": "https://wails.io/schemas/config.v2.json",
  "name": "gie",
  "version": "2.0.0",
  "outputfilename": "gie",
  "frontend:install": "npm install",
  "frontend:build": "npm run build",
  "frontend:dev:watcher": "npm run dev",
  "frontend:dev:serverUrl": "auto",
  "author": {
    "name": "Aiskoa",
    "email": "aiskoa@mail.com"
  },
  "info": {
    "companyName": "AISKOA",
    "productName": "GIE - Go-based Information Encryptor",
    "productVersion": "2.0.0",
    "copyright": "Copyright © 2024-2025 AISKOA. All rights reserved.",
    "comments": "Enhanced file encryption with multiple algorithms and themes"
  },
  "options": {
    "windows": {
      "width": 520,
      "height": 820,
      "resizable": false,
      "webviewIsTransparent": false,
      "windowIsTranslucent": false,
      "disableWindowIcon": false
    },
    "mac": {
      "titleBarAppearsTransparent": true,
      "webviewIsTransparent": true,
      "windowIsTranslucent": false
    },
    "linux": {
      "icon": "ico/favicon.png",
      "webviewGpuPolicy": "always"
    }
  }
}
